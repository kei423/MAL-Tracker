{
  "manifest_version": 3,
  "name": "Anime Tracker & Extractor",
  "version": "1.0",
  "description": "Extracts current anime name, episode, and watch progress.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://anikototv.to/*",
    "*://*.anikototv.to/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anime Info"
  },
  "content_scripts": [
    {
      "matches": [
        "*://anikototv.to/*",
        "*://*.anikototv.to/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}