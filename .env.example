DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=tracker
DB_USER=tracker
DB_PASSWORD=replace_with_a_local_password

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=tracker
RABBITMQ_PASSWORD=replace_with_a_local_password
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=mal.sync

MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:8080/
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MAL_TOKEN_KEY=
# Import MAL lists this often while sync:worker is running; tokens refresh only when needed.
MAL_LIST_SYNC_INTERVAL_SECONDS=10
